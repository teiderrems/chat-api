// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int            @id @default(autoincrement())
  firstName       String?           @map("firstname") @db.VarChar(100)
  lastName        String?           @map("lastname") @db.VarChar(100)
  email           String?           @unique @map("email") @db.VarChar(100)
  phoneNumber     String            @unique @map("phone") @db.VarChar(12)
  profil          String?           @map("image_id") @db.VarChar(150)
  createdAt       DateTime?          @map("created_at") @db.Timestamp()
  updatedAt       DateTime?          @updatedAt @map("updated_at") @db.Timestamp()
  Message         Message[]
  Chat            Chat[]
  ChatUserMessage ChatUserMessage[]
  UserGroup       UserGroup[]

  @@map("users")
}

model Message {
  id              Int            @id @default(autoincrement())
  content         String?           @default("") @map("content") @db.VarChar(500)
  isRead          Boolean           @db.Boolean @default(false)
  ownerId         Int           
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt       DateTime?          @map("created_at") @db.Timestamp()
  updatedAt       DateTime?          @updatedAt @map("updated_at") @db.Timestamp()
  File            File[]
  ChatUserMessage ChatUserMessage[]

  @@map("messages")
}

model File {
  id        Int   @id @default(autoincrement())
  fileUrl   String   @map("file_url") @db.VarChar(100)
  messageId Int  
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp()

  @@map("files")
}

model Chat {
  id              Int            @id @default(autoincrement())
  name            String?           @map("chat_name") @db.VarChar(100)
  ownerId         Int            @map("owner")
  owner           User              @relation(fields: [ownerId], references: [id])
  createdAt       DateTime?          @map("created_at") @db.Timestamp()
  updatedAt       DateTime?          @updatedAt @map("updated_at") @db.Timestamp()
  ChatUserMessage ChatUserMessage[]
  Group           Group[]

  @@map("chats")
}

model ChatUserMessage {
  id        Int   @id @default(autoincrement())
  ownerId   Int  
  chatId    Int  
  messageId Int  
  owner     User     @relation(fields: [ownerId], references: [id])
  message   Message? @relation(fields: [messageId], references: [id])
  chat      Chat     @relation(fields: [chatId], references: [id])
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp()

  @@unique([ownerId, messageId, chatId])
  @@map("chats_users_messages")
}

model Group {
  id        Int      @id @default(autoincrement())
  name      String      @db.VarChar(100)
  description String? @db.VarChar(500)
  createdAt DateTime?    @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime?    @updatedAt @map("updated_at") @db.Timestamp()
  UserGroup UserGroup[]
  chatId    Int     
  chat      Chat        @relation(fields: [chatId], references: [id])

  @@map("groups")
}

model UserGroup {
  id       Int @id @default(autoincrement())
  memberId Int
  member   User   @relation(fields: [memberId], references: [id])
  groupId  Int
  group    Group  @relation(fields: [groupId], references: [id])

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp()

  @@map("users_groups")
}
